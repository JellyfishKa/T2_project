# -----------------------------
# T2 backend server environment
# -----------------------------

# Runtime
DEBUG=false
CORS_ORIGINS=https://your-frontend-domain.com

# LLM models (local GGUF)
QWEN_API_ENDPOINT=local
QWEN_MODEL_ID=qwen2-0_5b-instruct-q4_k_m.gguf
LLAMA_API_ENDPOINT=local
LLAMA_MODEL_ID=Llama-3.2-1B-Instruct-Q4_K_M.gguf

# Optional Hugging Face token
HF_TOKEN=

# Database
DATABASE_USER=t2_app
DATABASE_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5432
DATABASE_NAME=t2_prod

# ML-first routing policy
ROUTING_PRIMARY_MODE=algorithm_primary
ROUTING_ENABLE_LLM_FALLBACK=true
ROUTING_LLM_FALLBACK_MODEL=llama
ROUTING_QUALITY_FLOOR=60
ROUTING_ENABLE_LLM_VARIANT_EVALUATION=false
ROUTING_ALLOW_DIRECT_LLM_ROUTES=false
ROUTING_DEFAULT_ALTERNATIVES_COUNT=3
ROUTING_WEIGHT_DISTANCE=0.4
ROUTING_WEIGHT_TIME=0.3
ROUTING_WEIGHT_COST=0.2
ROUTING_WEIGHT_QUALITY=0.1

# Default depot (can be overridden later per rep/tenant)
DEFAULT_DEPOT_LAT=54.1871
DEFAULT_DEPOT_LON=45.1749

# Security
SECURITY_ENABLE_API_KEY_AUTH=true
SECURITY_API_KEY=REPLACE_WITH_LONG_RANDOM_API_KEY
SECURITY_ADMIN_API_KEY=REPLACE_WITH_LONG_RANDOM_ADMIN_KEY
SECURITY_ALLOW_BULK_LOCATION_DELETE=false
SECURITY_ALLOW_BENCHMARK_RUN=false
